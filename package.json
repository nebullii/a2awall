{
  "name": "a2awall",
  "version": "0.2.0",
  "description": "A reusable A2A wrapper with an additional security layer for custom agents.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    ".env.example"
  ],
  "main": "./dist/lib.js",
  "types": "./dist/lib.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./client": {
      "types": "./dist/client/connect.d.ts",
      "import": "./dist/client/connect.js"
    }
  },
  "bin": {
    "a2awall-connect": "./dist/cli/connect.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "smoke": "tsx src/smoke.ts",
    "test": "npm run build && node dist/test.js && node dist/e2e.js",
    "connect": "npm run build && node dist/cli/connect.js",
    "test:unit": "npm run build && node dist/test.js",
    "test:e2e": "npm run build && node dist/e2e.js",
    "scenario:adversarial": "npm run build && node dist/scenarios/adversarial.js",
    "scenario:report": "npm run build && node dist/scenarios/report.js"
  },
  "keywords": [
    "a2a",
    "agent",
    "agent-card",
    "json-rpc",
    "security",
    "middleware",
    "typescript"
  ],
  "license": "MIT",
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
