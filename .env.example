PORT=4000
BASE_URL=http://localhost:4000

# Development credential. Replace it, and outside development supply the digest
# instead of the secret: SECURITY_BEARER_TOKEN_SHA256=$(printf %s "$TOKEN" | shasum -a 256 | cut -d' ' -f1)
# Setting both SECURITY_BEARER_TOKEN and SECURITY_BEARER_TOKEN_SHA256 is an error.
SECURITY_BEARER_TOKEN=dev-token
# SECURITY_BEARER_TOKEN_SHA256=

SECURITY_PRINCIPAL_ID=secured-caller

# Required whenever SECURITY_ALLOWED_CAPABILITIES is set. Scopes are the grant
# and are never derived from the capability list: a grant derived from its own
# requirement would make the scope check vacuous.
SECURITY_SCOPES=agent:invoke,agent:echo

# May only name capabilities that already have a policy (echo, template-echo).
# Define new capabilities by building a SecurityPolicy in code, not here.
SECURITY_ALLOWED_CAPABILITIES=echo

# Informational, published on the Agent Card. Not an enforced control: an opaque
# bearer token carries no audience claim.
SECURITY_AUDIENCE=trusted-a2a-clients

# One of: public, partner, internal, privileged. An unrecognised value is an
# error rather than a fallback.
SECURITY_TRUST_TIER=internal
